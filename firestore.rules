rules_version = '2';

// Askel 5K: jokainen käyttäjä näkee ja muokkaa vain omia tietojaan polussa users/{uid}/...
// (settings/main, log/{id}, coach/last). Kaikki muu on suljettu.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
